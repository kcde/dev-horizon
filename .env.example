# Public Sanity config (safe to expose)
NEXT_PUBLIC_SANITY_PROJECT_ID=8tnqf6xe
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Server-only. Editor token for `npm run seed` (sanity.io/manage → API → Tokens). Never commit.
SANITY_API_WRITE_TOKEN=

# Server-only. Shared secret for the Sanity publish webhook → /api/revalidate. Never commit.
SANITY_REVALIDATE_SECRET=
